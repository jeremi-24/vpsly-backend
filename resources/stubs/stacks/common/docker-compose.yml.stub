services:
  app:
    image: {{IMAGE_NAME}}
    container_name: {{APP_NAME}}
    restart: always
    pull_policy: never
    expose:
      - "{{APP_PORT}}"
    env_file:
      - .env
    networks:
      - vpsly_network
{{VOLUMES}}
{{RESOURCES}}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{APP_ID}}.rule=Host(`{{DOMAIN}}`)"
      - "traefik.http.routers.{{APP_ID}}.entrypoints=web,websecure"
      - "traefik.http.routers.{{APP_ID}}.tls=true"
      - "traefik.http.routers.{{APP_ID}}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{APP_ID}}.loadbalancer.server.port={{APP_PORT}}"



networks:
  vpsly_network:
    external: true

{{VOLUME_DEFINITIONS}}

