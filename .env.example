APP_NAME=VPSly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.vpsly.tech
FRONTEND_URL=https://app.vpsly.tech

# CORS - Séparer par des virgules
CORS_ALLOWED_ORIGINS=https://app.vpsly.tech,http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vpsly
DB_USERNAME=root
DB_PASSWORD=

# Services
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://api.vpsly.tech/auth/github/callback

GENIUSPAY_MERCHANT_ID=
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.vpsly.tech/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URL=https://api.vpsly.tech/auth/google/drive/callback

# Broadcasting & Queues
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
CACHE_STORE=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
